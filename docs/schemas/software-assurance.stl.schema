# Software Assurance Schema
# Security, privacy, quality, provenance, licenses, and compliance evidence.

schema SoftwareAssurance v1.0 {
    namespace "Assurance"

    anchor source {
        pattern: /(Threat|Risk|Finding|Vulnerability|Control|Evidence|License|SBOM|Attestation|ProcessingActivity|DataCategory|ComplianceRequirement)_[A-Za-z0-9_]+/
    }

    anchor target {
        pattern: /(Threat|Risk|Finding|Vulnerability|Control|Evidence|License|SBOM|Attestation|ProcessingActivity|DataCategory|ComplianceRequirement|Project|System|Service|Component|Module|API|Endpoint|DataStore|Data|Package|SourceFile|Artifact|Build|Deployment)_[A-Za-z0-9_]+/
    }

    modifier {
        required: [relation]
        optional: [severity, likelihood, impact, status, source, identifier, version, timestamp, description, spdx_id, license_expression, cve, cwe, sarif_rule, purl]

        relation: enum("threatens", "affects", "detects", "reports", "mitigates", "protects", "satisfies", "violates", "licensed_under", "contains", "derived_from", "attests", "processes", "stores", "transfers", "retains")
        severity: enum("critical", "high", "medium", "low", "info")
        likelihood: float(0.0, 1.0)
        impact: float(0.0, 1.0)
        status: string
        source: string
        identifier: string
        version: string
        timestamp: datetime
        description: string
        spdx_id: string(/SPDXRef-[A-Za-z0-9.-]+/)
        license_expression: string(/[A-Za-z0-9().+ -]+/)
        cve: string(/CVE-[0-9]{4}-[0-9]{4,}/)
        cwe: string(/CWE-[0-9]+/)
        sarif_rule: string(/[A-Za-z0-9_.-]+/)
        purl: string(/pkg:.+/)
    }

    edge {
        source: [Threat, Risk, Finding, Vulnerability, Control, Evidence, License, SBOM, Attestation, ProcessingActivity, DataCategory, ComplianceRequirement]
        relation: [threatens, affects, detects, reports, mitigates, protects, satisfies, violates, licensed_under, contains, derived_from, attests, processes, stores, transfers, retains]
        target: [Threat, Risk, Finding, Vulnerability, Control, Evidence, License, SBOM, Attestation, ProcessingActivity, DataCategory, ComplianceRequirement, Project, System, Service, Component, Module, API, Endpoint, DataStore, Data, Package, SourceFile, Artifact, Build, Deployment]
    }

    constraints {
        min_statements: 1
        max_statements: 1000
    }
}
