# Software Operations Schema
# Runtime identity, observability, reliability, and incident response.

schema SoftwareOperations v1.0 {
    namespace "Operations"

    anchor source {
        pattern: /(Instance|Metric|Log|Trace|Alert|SLO|Runbook|Incident|Remediation)_[A-Za-z0-9_]+/
    }

    anchor target {
        pattern: /(Instance|Metric|Log|Trace|Alert|SLO|Runbook|Incident|Remediation|System|Service|Component|Environment|Deployment)_[A-Za-z0-9_]+/
    }

    modifier {
        required: [relation]
        optional: [severity, status, value, unit, threshold, environment, source, time, timestamp, description, service_name]

        relation: enum("runs_as", "runs_on", "observes", "measures", "emits", "monitors", "triggers", "violates", "causes", "affects", "mitigates", "resolves")
        severity: enum("critical", "high", "medium", "low", "info")
        status: string
        value: string
        unit: string
        threshold: string
        environment: string
        source: string
        time: datetime
        timestamp: datetime
        description: string
        service_name: string(/[A-Za-z0-9_.-]+/)
    }

    edge {
        source: [Instance, Metric, Log, Trace, Alert, SLO, Runbook, Incident, Remediation]
        relation: [runs_as, runs_on, observes, measures, emits, monitors, triggers, violates, causes, affects, mitigates, resolves]
        target: [Instance, Metric, Log, Trace, Alert, SLO, Runbook, Incident, Remediation, System, Service, Component, Environment, Deployment]
    }

    constraints {
        min_statements: 1
        max_statements: 1000
    }
}
