# Software Review Schema  (DRAFT — community profile)
#
# Governs agent-to-agent REVIEW edges: gates, QA, independence, merges, patches,
# and the assessment layer (findings, evidence). Companion to software-agentcoord.
#
# Design notes: docs/schemas/agent-comms.md
#
# STATUS: draft. Requires stl-parser >= 1.11.0 (the require{} cross-statement rule
# + resolvers= hook). The merge-gate requirement below is now ENFORCED: a merge
# with no independent, registry-resolved verify=pass fails validation (E612) —
# the SPECIALIST_QA deadlock becomes a validation error. The host supplies the
# identity registry at validation time via resolvers={"identity": fn}; without a
# resolver the gate fails closed (unresolvable gate). Action-keyed edge typing
# remains deferred until the engine keys edge rules on action.

schema SoftwareReview v0.2 {
    namespace "Review"

    anchor source {
        namespace: required("Review")
        pattern: /(Gate|Check|Verifier|Guard|Finding|RequiredAction|Patch|Acceptance|Evidence|Defect|Run|Lane|Revision)_[A-Za-z0-9_]+/
    }
    anchor target {
        pattern: /(Gate|Check|Verifier|Guard|Finding|RequiredAction|Patch|Acceptance|Evidence|Defect|Run|Lane|Revision|WorkItem|Branch|Artifact|Commit)_[A-Za-z0-9_]+/
    }

    modifier {
        required: [action, priority, confidence, provenance, source, author, timestamp]
        optional: [outcome, status, severity, about_phase, certainty, obligation, owner,
                   notify, run_id, work_item, verifier, claimant, commit, command, result,
                   note, detail]

        # verbs are speech-acts; pass/fail lives on `outcome`, never fused into the verb.
        # validate = self-check, verify = independent (owner Q2). Independence is made
        # checkable by recording `verifier` and `claimant`; a validator can test verifier != claimant.
        action: enum("gate", "check", "validate", "verify", "merge", "patch", "bounce",
                     "accept", "require", "finding", "evidence", "independence", "correction")

        outcome: enum("pass", "fail", "warn", "skip", "blocked", "pending", "no_change")
        provenance: enum("verified", "reported", "claimed", "inferred")

        priority: integer
        confidence: float(0.0, 1.0)
        certainty: float(0.0, 1.0)

        # risk/impact axis — distinct from priority (scheduling). Assessment edges only.
        severity: enum("critical", "high", "medium", "low", "info")

        about_phase: enum("backlog", "ready", "coding", "testing", "deployed", "closed")
        obligation: enum("must", "should", "may")
        status: string
        command: string
        result: string
        note: string
        detail: string
        author: string
        owner: string
        notify: string
        verifier: string
        claimant: string
        commit: string(/[A-Fa-f0-9]{7,64}/)
        source: string(/(https|git|kumidai|sha256|file).+/)
        run_id: string(/[a-z0-9_]+/)
        work_item: string(/[A-Z]+-[0-9]+/)
        timestamp: datetime
    }

    # ENFORCED (stl-parser >= 1.11.0): a merge is valid only if the document also
    # carries an independent, registry-resolved verify with outcome=pass. Independence
    # = verifier != claimant on the verify edge; the "identity" resolver (host-supplied)
    # confirms the verifier is a real, eligible member. Unsatisfiable -> E612, naming the
    # missing binding. This is the structural fix for the SPECIALIST_QA deadlock: a merge
    # gate required from a role bound to nobody can no longer sit silently — it fails.
    require {
        action: "merge"
        binding: "verify"
        outcome: "pass"
        independent: true
        resolver: "identity"
    }

    # STILL DEFERRED (needs action-keyed edge rules in the engine): typing which action
    # is legal between which node types, e.g. Gate -gate-> Branch, Verifier -verify->
    # Revision, Finding -finding-> WorkItem. The require rule above governs cross-statement
    # obligations; per-edge node-typing waits on edge{} keying on action rather than relation.

    constraints {
        min_statements: 1
        max_statements: 2000
    }
}
