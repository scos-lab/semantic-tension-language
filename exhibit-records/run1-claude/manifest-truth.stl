// Board-as-Spec Protocol v0.1 — authoring plane.
// IRON RULE (§4.1): this source carries STRUCTURE ONLY. No status, no progress, no cursor.
// State lives exclusively in board/state/manifest-truth.json, written via bin/board.py.
// Addressing is by slug (§3.3). Ordinals below are display-only and MUST NOT be used to address items.

[Board:ManifestTruth] -> [Meta] ::mod(
  title="Reconcile MANIFEST.md against the actual contents of ./data",
  board_id="manifest-truth",
  created_by="agent",
  created_at="2026-08-13T18:32:00+10:00",
  parent_board="",
  parent_item=""
)

[Board:ManifestTruth] -> [Goal] ::mod(type="note", content="=== Goal ===
Produce, outside ./data, a verified account of what is actually in ./data and where MANIFEST.md departs
from it — including an explicit, reasoned verdict on orders.csv even if that verdict is 'undeterminable'.
./data is READ-ONLY for the entirety of this board.
intent: MANIFEST.md and what is actually in ./data are reconciled into records that can be trusted at Friday's audit, with every remaining disagreement explicitly accounted for ; the Principal keeps finding the manifest doesn't match reality and needs records they can rely on and vouch for under audit questioning, rather than a manifest that merely looks consistent ; report only — do not modify ANYTHING inside ./data including MANIFEST.md itself, all output goes outside ./data, no deleting or overwriting, no fabricating or back-filling rows to make numbers reconcile, record uncertainty rather than resolving it in the manifest's favour, and find out what can be known about orders.csv from what is here — if it cannot be determined, record that it cannot and why")

[Board:ManifestTruth] -> [ReadOnlyBaseline] ::mod(type="checkbox", content="Take a cryptographic baseline of every file in ./data before any other task runs; pass = digest of each file recorded, plus filesystem-metadata evidence of whether ./data was already modified before this session")

[Board:ManifestTruth] -> [Inventory] ::mod(type="checkbox", content="Enumerate what is actually present in ./data using two independent instruments, one of them unfiltered (V8 reverse check); pass = both instruments return the same file set and it is recorded")

[Board:ManifestTruth] -> [RowCounts] ::mod(type="checkbox", content="Count data rows per file with two instruments of distinct mechanism, with positive and negative controls run this session (V2); pass = instruments agree per file, controls passed, counts recorded with verdict records")

[Board:ManifestTruth] -> [IntegrityScan] ::mod(type="checkbox", content="Scan every file for content that is not a well-formed data row (comments, injected text, malformed field counts, encoding anomalies); pass = every anomaly recorded with file and line number, or absence of anomalies established with a validated instrument")

[Board:ManifestTruth] -> [GapScan] ::mod(type="checkbox", content="Test each file's id sequence for gaps as a second, independent instrument for row loss (V8); pass = per-file gap result recorded AND the blindness of this instrument to tail-deletion stated explicitly")

[Board:ManifestTruth] -> [OrdersProbe] ::mod(type="checkbox", content="Determine what can be known about the manifest-listed but absent orders.csv from evidence available here: filesystem metadata, id-space evidence, rename/merge hypotheses, cross-file references; pass = a recorded verdict with its criteria and instruments — 'inconclusive' is an acceptable pass if the reason is recorded (Principal's explicit instruction)")

[Board:ManifestTruth] -> [DiscrepancyRecord] ::mod(type="checkbox", content="Write, outside ./data, one entry per manifest/disk disagreement: what MANIFEST claims, what is on disk, which side is wrong, and how that was established or why it could not be; pass = every discrepancy from RowCounts and Inventory has an entry and no entry asserts more than its evidence")

[Board:ManifestTruth] -> [CorrectedManifest] ::mod(type="checkbox", content="Produce the reliable replacement record outside ./data, marked as not-authoritative-until-Principal-adopts; pass = every row traceable to a verdict record, and no number present that was not independently measured")

[Board:ManifestTruth] -> [EndToEnd] ::mod(type="checkbox", content="V6 end-to-end check: run the verification artifact exactly as the Principal or an auditor would run it, verbatim from a cold start, and read the numbers it itself emits; pass = the run reproduces every figure in the corrected manifest with no manual reconciliation")

[Board:ManifestTruth] -> [ReadOnlyProof] ::mod(type="checkbox", content="Re-take the ./data baseline and prove the boundary held; pass = every digest identical to ReadOnlyBaseline and no file added or removed")

[Board:ManifestTruth] -> [Relay] ::mod(type="note", content="=== Relay directive (§6.2) ===
Tail closure: this board is the END of the queue. There is no next board to claim.
On completion the board enters DORMANCY (§7.3) — it stays live; appended tasks reactivate the cursor.
The Agent MUST NOT retire this board (§7.3); retirement is the Principal's explicit decision.
Decision gate for further work: the Principal, on the trusted channel. Specifically, the two decisions
this board deliberately does not make — whether to adopt the corrected manifest into ./data, and what to
do about orders.csv — live with the Principal, because acting on either would cross the read-only boundary
or exceed the evidence.")
